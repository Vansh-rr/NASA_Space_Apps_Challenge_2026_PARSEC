# Explicit upload allowlist. Deliberately do not include .gitignore:
# the deployment database is ignored by Git but required in the build context.
*
!Dockerfile
!.dockerignore
!requirements-api.txt
!requirements-tested.txt
!phase1_*.py
!phase2/
phase2/*
!phase2/__init__.py
!phase2/phase2_config.py
!phase2/model_preview.py
!phase3/
phase3/*
!phase3/__init__.py
!phase3/api.py
!configs/
configs/*
!configs/phase2.yaml
!model_preview/
model_preview/*
!model_preview/bc-july-2023/
model_preview/bc-july-2023/*
!model_preview/bc-july-2023/manifest.json
!model_preview/bc-july-2023/metadata.json
!model_preview/bc-july-2023/cells.geojson
!model_preview/bc-july-2023/field.json
!model_preview/bc-july-2023/validation.json
!model_preview/bc-july-2023/field_posterior.csv
!model_preview/bc-july-2023/report.json
!model_preview/bc-july-2023/comparison_metrics.csv
!data/
data/*
!data/fires.duckdb
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/.netrc
**/*credentials*.json
**/*service-account*.json
