# Optional. Raster tile URL template for the satellite basemap ({z}/{x}/{y} placeholders).
# Default: Esri World Imagery. Check the provider's terms before production use.
VITE_SATELLITE_TILES=
# Attribution text shown on every map. Required by the imagery provider.
VITE_SATELLITE_ATTRIBUTION=
VITE_API_BASE_URL=http://localhost:8000

